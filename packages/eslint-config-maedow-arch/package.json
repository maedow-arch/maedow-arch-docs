{
  "name": "eslint-config-maedow-arch",
  "version": "0.3.0",
  "description": "Règles ESLint de Maedow Arch. Applique les frontières app/features/core/components/lib au moyen d'eslint-plugin-boundaries",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./strict": "./strict.js"
  },
  "keywords": [
