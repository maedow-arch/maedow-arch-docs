    "eslintconfig",
    "maedow-arch",
    "architecture",
    "boundaries",
    "clean-architecture",
    "typescript"
  ],
  "license": "MIT",
  "author": "Jean-Marc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maedow-arch/maedow-arch-docs.git",
    "directory": "packages/eslint-config-maedow-arch"
  },
  "homepage": "https://github.com/maedow-arch/maedow-arch-docs#readme",
  "bugs": {
    "url": "https://github.com/maedow-arch/maedow-arch-docs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "eslint-import-resolver-typescript": ">=4",
    "eslint-plugin-boundaries": ">=7",
    "eslint-plugin-import": ">=2.31",
    "typescript-eslint": ">=8"
  },
  "files": [
    "index.js",
    "strict.js",
    "README.md",
    "LICENSE"
